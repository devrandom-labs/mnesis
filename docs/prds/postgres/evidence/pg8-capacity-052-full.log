capacity plan edge=End query=WITH candidates AS (SELECT global_seq, version, txid, 32 + pg_catalog.octet_length(keys.value)::bigint + pg_catalog.octet_length(event_type)::bigint + pg_catalog.octet_length(payload)::bigint + COALESCE(pg_catalog.octet_length(metadata)::bigint, 0) AS row_bytes FROM mnesis.events JOIN mnesis.keys ON keys.number = events.stream_id WHERE txid OPERATOR(pg_catalog.<) $1::text::xid8 AND (txid, global_seq) OPERATOR(pg_catalog.>) ($2::text::xid8, $3) ORDER BY txid, global_seq LIMIT $4::text::bigint), ranked AS (SELECT *, ROW_NUMBER() OVER w AS ordinal, SUM(row_bytes) OVER w AS total_bytes FROM candidates WINDOW w AS (ORDER BY txid, global_seq ROWS UNBOUNDED PRECEDING)), settings AS (SELECT $5 AS byte_limit) SELECT row_bytes, byte_limit, events.version::text AS version, events.schema_version, events.global_seq, events.txid::text AS txid, CASE WHEN row_bytes <= byte_limit THEN keys.value END AS stream_id, CASE WHEN row_bytes <= byte_limit THEN events.event_type END AS event_type, CASE WHEN row_bytes <= byte_limit THEN events.payload END AS payload, CASE WHEN row_bytes <= byte_limit THEN events.metadata END AS metadata FROM ranked JOIN mnesis.events USING (global_seq) JOIN mnesis.keys ON keys.number = events.stream_id CROSS JOIN settings WHERE total_bytes <= byte_limit OR ordinal = 1 ORDER BY events.txid, events.global_seq parameters=["'20766'", "'20742'", "'999000'", "'128'", "'1048576'"]
